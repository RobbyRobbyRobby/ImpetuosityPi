class Rotation_Device_Config:
    _rotation_reversed = False #automaticaly reverse ann requested values
    _rotation_max = 90
    _rotation_home = 0
    _rotation_min = -90
    _rotation_current = 0
    _pca9685 = None
    _position_change_degrees_per_second = -1 #negative = instant change

    # Constructor
    def __init__(self, pca9685, index):
        if (pca9685 == None):
            raise Exception("Invalid arguments. You need a PCA9685 device.")
        else:
            self._pca9685 = pca9685

    def Set_Initial_Parameters(
            self,
            rotation_reversed = None,
            rotation_max = None,
            rotation_home = None,
            rotation_min = None,
            rotation_current = None,
            position_change_degrees_per_second = None):

        if (rotation_reversed != None):
            self._rotation_reversed = rotation_reversed
        if (rotation_max != None):
            self._rotation_max = rotation_max
        if (rotation_home != None):
            self.rotation_home = rotation_home
        if (rotation_min != None):
            self._rotation_min = rotation_min
        if (rotation_current != None):
            self._rotation_current = rotation_current
        if (position_change_degrees_per_second != None):
            self._position_change_degrees_per_second = position_change_degrees_per_second

class Rotation_Device:
    _rotation_reversed = False #automaticaly reverse ann requested values
    _rotation_current = 0
    _rotation_max = 0
    _rotation_home = 0
    _rotation_min = 0
    #_conf = None

    # Constructor
    def __init__(self, config):
        if (config == None):
            #self._conf = config
            config = Rotation_Device_Config()
        if (config != None):
            self._rotation_reversed = config._rotation_reversed
            self._rotation_current = config._rotation_current
            self._rotation_max = config._rotation_max
            self._rotation_home = config._rotation_home
            self._rotation_min = config._rotation_min
            self.Go_Home()

    # Destructor
    def __del__(self):
        pass

    def Set_Position(self, value):
        
        pass

    def Go_Home(self):
        self.Set_Position(self._rotation_home)
